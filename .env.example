# docker compose 환경변수. 이 파일을 .env 로 복사해 값을 채우세요.
# (backend/.env.example 는 백엔드 단독 실행용입니다.)

# --- PostgreSQL ---
POSTGRES_USER=lottery
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=lottery

# --- 백엔드 보안 ---
# 강한 무작위 값 (openssl rand -hex 32). 운영에서 기본/약한 값이면 기동 거부됩니다.
JWT_SECRET_KEY=change-me-openssl-rand-hex-32
# 실제 프론트 도메인을 JSON 배열로 지정 (예: ["https://lotto.example.com"])
CORS_ORIGINS=["http://localhost:3000"]
# 이 아이디로 가입한 첫 사용자를 관리자로 자동 승격 (관리자가 없을 때만)
INITIAL_ADMIN_USERNAME=

# --- 비밀번호 재설정 이메일 (Gmail SMTP) ---
# SMTP_PASSWORD 는 Gmail "앱 비밀번호"여야 합니다(2단계 인증 필요). 일반 비밀번호 아님.
# 비워두면 개발 환경에서는 메일 발송 대신 콘솔에 출력됩니다.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youngjong674@gmail.com
SMTP_PASSWORD=
SMTP_FROM=

# --- 프론트엔드 (빌드 타임에 인라인됨) ---
# 브라우저에서 접근 가능한 백엔드 주소 (예: https://api.lotto.example.com)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
