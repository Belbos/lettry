# SQLite for local dev. For production use PostgreSQL e.g.
# DATABASE_URL=postgresql+psycopg://user:pw@host:5432/lottery
DATABASE_URL=sqlite:///./lottery.db
CORS_ORIGINS=["http://localhost:3000"]

# Set to "production" to enforce strict security checks (rejects weak JWT secret).
APP_ENV=development

# REQUIRED in production. Generate a strong random value, e.g.:
#   openssl rand -hex 32
# Must be >= 32 chars and not the default below, or startup will fail in production.
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Admin bootstrap. The user who registers with this username is auto-promoted
# to admin, but ONLY while no admin exists yet (the env var stops granting
# admin once the first one is set up). Register this account immediately after
# deploy. Alternatively promote an existing user out-of-band:
#   python -m scripts.create_admin <username>
INITIAL_ADMIN_USERNAME=
